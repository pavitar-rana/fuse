generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  apiKey         String?
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  Virtualmachine Virtualmachine[]
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}


enum VmStatus {
  CREATING
  RUNNING
  PAUSED
  TERMINATING
  TERMINATED
  FAILED
}


model Virtualmachine {
  id         String @id @default(cuid())
  vmIp       String
  vmMac      String
  socket     String
  rootfsPath String
  userId     String
  vcpuCount  Int
  memSize    Int
  status     VmStatus @default(CREATING)
  hostId String
  host Host @relation(fields: [hostId], references:[id])

  portMappings PortMapping[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortMapping {
  id       String @id @default(cuid())
  vmId     String
  vmPort   Int
  hostPort Int

  vm Virtualmachine @relation(fields: [vmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([vmId, vmPort])
}

enum PoolStatus {
  AVAILABLE
  ALLOCATED
}

model Host {
  id String @id @default(cuid())
  hostname String @unique
  ipRange String 
  ipPool IpPool[]
  portPool PortPool[]
  vms Virtualmachine[]
}


model IpPool {

  id String @id @default(cuid())
  hostId String
  host Host @relation(fields: [hostId], references:[id] )
  ip String
  status PoolStatus @default(AVAILABLE)
  vmId String? @unique

  @@unique([hostId, ip])
  @@index([hostId, status])
}

model PortPool {
    id String @id @default(cuid())
    hostId String
    host Host @relation(fields: [hostId], references: [id])
    hostPort Int
    status PoolStatus @default(AVAILABLE)
    vmId String?
    @@unique([hostId, hostPort])
    @@index([hostId, status])
}
